# managed video dirs — raws and encodes are never committed (releases host them)
videos/raw/
videos/hq/
public/videos/
public/videos-hq
dist/
node_modules/
__pycache__/
*.egg-info/
# agent worktrees are checkouts of this repo, not part of it
.claude/worktrees/
# scratch probes (the files already tracked there stay: talk docs still point at them)
.tmp/
# stray masters safety net
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.avi
