{
  "name": "slidev-addon-videos",
  "version": "0.6.1",
  "type": "module",
  "description": "Slidev addon: full-bleed VideoPlayer streaming from GitHub Release assets with a local/remote fallback chain, and cut / fade / dust transitions",
  "repository": { "type": "git", "url": "https://github.com/MindaugasSarpis/slidev-videos.git" },
  "license": "MIT",
  "keywords": ["slidev-addon", "video", "keynote", "presentation"],
  "files": ["components", "global-top.vue", "README.md"],
  "peerDependencies": { "@slidev/cli": ">=52" },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "make:clip": "node scripts/make-example-clip.mjs",
    "build:example": "slidev build example/slides.md --out dist --base /",
    "smoke": "node scripts/smoke-example.mjs",
    "stage:test": "pnpm --filter slidev-addon-stage test",
    "stage:build": "pnpm --filter slidev-addon-stage build:example",
    "stage:smoke": "pnpm --filter slidev-addon-stage smoke",
    "stage:smoke:dev": "pnpm --filter slidev-addon-stage smoke:dev",
    "test:all": "pnpm test && pnpm make:clip && pnpm build:example && pnpm smoke && pnpm stage:test && pnpm stage:build && pnpm stage:smoke && pnpm stage:smoke:dev"
  },
  "devDependencies": {
    "@slidev/cli": "^52.1.0",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "~1.59.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["playwright-chromium"]
  }
}
